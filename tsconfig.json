{
  "compilerOptions": {
    /* 基礎與解析 */
    "target": "ES6",
    "module": "Node16",
    "moduleResolution": "node16",      // 解決警告且最穩定的解析方式
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    /* 輸出設定 */
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,                  // 確保會產生 .js 檔案
    "sourceMap": true,

    /* 強型別檢查 */
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    /* Google Cast SDK 型別 */
    "types": [
      "chrome",
      "chromecast-caf-sender"
    ]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}